<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Al-Fattah Drive Album</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome untuk Icon Modern -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .glass-panel {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.4);
        }
    </style>
</head>

<body class="relative min-h-screen font-sans antialiased bg-slate-950 text-slate-100 flex flex-col justify-between selection:bg-blue-500 selection:text-white">

  <!-- GAMBAR BACKGROUND .JPG -->
  <img src="/background.jpg" class="fixed inset-0 w-full h-full object-cover z-0 pointer-events-none" alt="Background">
  <!-- LAPISAN OVERLAY GELAP -->
  <div class="fixed inset-0 bg-slate-950/70 backdrop-blur-[2px] z-10 pointer-events-none"></div>

  <!-- CONTAINER UTAMA -->
  <div class="relative z-20 max-w-xl mx-auto px-4 py-8 w-full flex-grow flex flex-col">

    <!-- NAVBAR / HEADER -->
    <header class="glass-panel p-4 rounded-2xl shadow-xl flex justify-between items-center mb-6 transition-all">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-500 flex items-center justify-center shadow-lg shadow-blue-500/30 text-white">
          <i class="fa-solid fa-cloud text-lg"></i>
        </div>
        <div>
          <h1 class="font-extrabold text-sm sm:text-base tracking-wider text-slate-800 m-0">AL-FATTAH DRIVE</h1>
          <p class="text-[10px] text-slate-500 font-medium">Cloud Storage & Arsip</p>
        </div>
      </div>
      
      <div class="flex items-center gap-2">
        <a href="https://hidaybase.my.id" class="px-3.5 py-2 rounded-xl text-xs font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200 shadow-sm transition-all flex items-center gap-1.5" style="text-decoration: none;">
          <i class="fa-solid fa-house text-slate-500"></i> Home
        </a>

        <% if (isAdmin) { %>
          <a href="/logout" class="px-3.5 py-2 rounded-xl text-xs font-semibold bg-rose-500 text-white hover:bg-rose-600 shadow-lg shadow-rose-500/25 transition-all flex items-center gap-1.5" style="text-decoration: none;">
            <i class="fa-solid fa-right-from-bracket"></i> Logout
          </a>
        <% } else { %>
          <a href="/login" class="px-3.5 py-2 rounded-xl text-xs font-semibold bg-blue-600 text-white hover:bg-blue-700 shadow-lg shadow-blue-600/25 transition-all flex items-center gap-1.5" style="text-decoration: none;">
            <i class="fa-solid fa-lock"></i> Admin
          </a>
        <% } %>
      </div>
    </header>

    <!-- FORM TAMBAH ALBUM (KHUSUS ADMIN) -->
    <% if (isAdmin) { %>
      <div class="glass-panel p-6 rounded-2xl shadow-xl mb-6 border border-white/60">
        <div class="flex items-center gap-2 mb-4 text-slate-800">
          <i class="fa-solid fa-folder-plus text-blue-600"></i>
          <h2 class="text-sm font-bold tracking-wide uppercase">Tambah Album Baru</h2>
        </div>
        <form action="/add-link" method="POST" class="space-y-3.5">
          <div>
            <label class="block text-[11px] font-bold text-slate-600 mb-1 uppercase tracking-wider">Nama Album</label>
            <input type="text" name="nama_album" required placeholder="Contoh: Album Pengurus 2026" class="w-full px-3.5 py-2.5 bg-white/80 border border-slate-200 rounded-xl text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500 transition">
          </div>
          <div>
            <label class="block text-[11px] font-bold text-slate-600 mb-1 uppercase tracking-wider">URL Link Google Drive</label>
            <input type="url" name="url_link" required class="w-full px-3.5 py-2.5 bg-white/80 border border-slate-200 rounded-xl text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500 transition" placeholder="https://drive.google.com/...">
          </div>
          <div>
            <label class="block text-[11px] font-bold text-slate-600 mb-1 uppercase tracking-wider">Sandi Album <span class="font-normal text-slate-400">(Opsional)</span></label>
            <input type="text" name="password" class="w-full px-3.5 py-2.5 bg-white/80 border border-slate-200 rounded-xl text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500 transition" placeholder="Kosongkan jika bebas diakses">
          </div>
          <button type="submit" class="w-full py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white font-semibold rounded-xl text-sm shadow-lg shadow-emerald-600/25 transition-all flex items-center justify-center gap-2">
            <i class="fa-solid fa-check"></i> Simpan Album
          </button>
        </form>
      </div>
    <% } %>

    <!-- DAFTAR ALBUM -->
    <div class="space-y-4 flex-grow">
      <div class="flex items-center justify-between px-1">
        <h2 class="text-xs font-bold text-slate-300 tracking-wider uppercase flex items-center gap-2">
          <i class="fa-solid fa-folder-open text-blue-400"></i> Daftar Album
        </h2>
        <span class="text-[11px] text-slate-400 font-medium"><%= links.length %> Folder Tersedia</span>
      </div>
      
      <% if (links.length === 0) { %>
        <div class="text-center bg-white/10 backdrop-blur-md p-8 rounded-2xl border border-white/10">
          <i class="fa-solid fa-box-open text-3xl text-slate-400 mb-2"></i>
          <p class="text-slate-300 text-sm">Belum ada album yang disimpan.</p>
        </div>
      <% } %>

      <% links.forEach((link) => { %>
        <div class="glass-panel p-4 rounded-2xl shadow-lg transition-all duration-300 hover:shadow-xl group">
          <% if (link.password && link.password !== "") { %>
            <!-- Jika album dikunci dengan sandi -->
            <form action="/verify-album/<%= link.id %>" method="POST" class="flex flex-col gap-3">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-500 text-base">
                            <i class="fa-solid fa-folder-closed"></i>
                        </div> 
                        <div>
                            <span class="font-bold text-slate-800 text-sm block"><%= link.nama_album %></span>
                            <span class="inline-flex items-center gap-1 text-[10px] font-semibold bg-rose-50 text-rose-600 border border-rose-200 px-2 py-0.5 rounded-full mt-0.5">
                                <i class="fa-solid fa-lock text-[8px]"></i> Terkunci
                            </span>
                        </div>
                    </div>
                </div>
                <div class="flex gap-2 pt-1">
                    <input type="password" name="input_password" placeholder="Masukkan Sandi..." required class="border border-slate-200 bg-white/90 px-3.5 py-2 rounded-xl text-sm w-full focus:outline-none focus:ring-2 focus:ring-blue-500 text-slate-800">
                    <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2 rounded-xl text-sm font-semibold shadow-md shadow-blue-600/20 transition-all flex items-center gap-1.5 shrink-0">
                        <span>Buka</span> <i class="fa-solid fa-arrow-right text-xs"></i>
                    </button>
                </div>
            </form>
          <% } else { %>
            <!-- Jika album bebas (tanpa sandi) -->
            <a href="<%= link.url_link %>" target="_blank" class="flex items-center justify-between text-slate-800 font-semibold group-hover:text-blue-600 transition-all">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-blue-600 text-base group-hover:scale-105 transition">
                        <i class="fa-solid fa-folder"></i>
                    </div>
                    <div>
                        <span class="text-sm block font-bold text-slate-800"><%= link.nama_album %></span>
                        <span class="text-[11px] text-slate-400 font-normal">Klik untuk membuka folder</span>
                    </div>
                </div>
                <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-400 group-hover:bg-blue-50 group-hover:text-blue-600 transition">
                    <i class="fa-solid fa-chevron-right text-xs"></i>
                </div>
            </a>
          <% } %>

          <!-- KONTROL ADMIN (NAIK, TURUN, EDIT, HAPUS) -->
          <% if (isAdmin) { %>
            <div class="flex items-center justify-between pt-3 mt-3 border-t border-slate-200/60 text-xs">
              <div class="flex items-center gap-1">
                <form action="/urutan-link/<%= link.id %>/naik" method="POST" class="m-0">
                  <button type="submit" class="w-7 h-7 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center transition" title="Pindah ke atas">
                    <i class="fa-solid fa-arrow-up text-[10px]"></i>
                  </button>
                </form>
                
                <form action="/urutan-link/<%= link.id %>/turun" method="POST" class="m-0">
                  <button type="submit" class="w-7 h-7 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center transition" title="Pindah ke bawah">
                    <i class="fa-solid fa-arrow-down text-[10px]"></i>
                  </button>
                </form>
              </div>

              <div class="flex items-center gap-2">
                <button type="button" onclick="editLink('<%= link.id %>', '<%= link.nama_album.replace(/'/g, `\\'` ) %>', '<%= link.url_link %>', '<%= link.password || '' %>')" class="px-3 py-1.5 rounded-lg bg-amber-500 hover:bg-amber-600 text-white font-medium shadow-sm transition flex items-center gap-1">
                  <i class="fa-solid fa-pen-to-square text-[10px]"></i> Edit
                </button>
                
                <form action="/delete-link/<%= link.id %>" method="POST" class="m-0">
                  <button type="submit" class="px-3 py-1.5 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-600 font-medium transition flex items-center gap-1" onclick="return confirm('Yakin ingin menghapus album ini?')">
                    <i class="fa-solid fa-trash text-[10px]"></i> Hapus
                  </button>
                </form>
              </div>
            </div>
          <% } %>
        </div>
      <% }) %>
    </div>

    <!-- FOOTER -->
    <footer class="mt-16 mb-4 text-center text-xs text-slate-400 tracking-wide space-y-1">
      <p>
        Powered by: 
        <a href="https://www.instagram.com/hiday.its" target="_blank" class="text-blue-400 hover:text-blue-300 font-semibold transition-all" style="text-decoration: none;">
          @hiday.its
        </a>
      </p>
      <p class="text-slate-500 text-[11px]">
        email@hidaybase.my.id
      </p>
    </footer>

  </div>

  <!-- SCRIPT PROMPT EDIT -->
  <script>
  function editLink(id, namaLama, urlLama, passwordLama) {
      const namaBaru = prompt("Masukkan Nama Album Baru:", namaLama);
      if (namaBaru === null) return;
      
      const urlBaru = prompt("Masukkan URL Link Baru:", urlLama);
      if (urlBaru === null) return;
      
      const passwordBaru = prompt("Masukkan Sandi Baru (kosongkan jika tidak ingin dikunci):", passwordLama);
      if (passwordBaru === null) return;

      if (!namaBaru.trim() || !urlBaru.trim()) {
          alert("Nama dan URL tidak boleh kosong!");
          return;
      }
      
      const form = document.createElement('form');
      form.method = 'POST';
      form.action = '/edit-link/' + id;
      
      const inputNama = document.createElement('input');
      inputNama.type = 'hidden';
      inputNama.name = 'nama_album';
      inputNama.value = namaBaru.trim();
      
      const inputUrl = document.createElement('input');
      inputUrl.type = 'hidden';
      inputUrl.name = 'url_link';
      inputUrl.value = urlBaru.trim();

      const inputPassword = document.createElement('input');
      inputPassword.type = 'hidden';
      inputPassword.name = 'password';
      inputPassword.value = passwordBaru.trim();
      
      form.appendChild(inputNama);
      form.appendChild(inputUrl);
      form.appendChild(inputPassword);
      document.body.appendChild(form);
      form.submit();
  }
  </script>
</body>
</html>

